[Unit]
Description=Reconstruye la imagen de Clipo con el yt-dlp más reciente
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=__CLIPO_USER__
WorkingDirectory=__CLIPO_DIR__
ExecStart=__CLIPO_DIR__/scripts/rebuild.sh
TimeoutStartSec=3600
