# Copia este archivo a .env y rellena los valores.

# Token que usan la PWA (login) y el Atajo de iOS (header X-API-Key).
# Genera uno con: openssl rand -hex 24
API_TOKEN=

# Firma las cookies de sesión. Genera uno con: openssl rand -hex 32
SECRET_KEY=

# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=
# Quita esta línea para no levantar el túnel (pruebas locales).
COMPOSE_PROFILES=tunnel

# Horas que se conserva el archivo descargado en el servidor.
FILE_TTL_HOURS=6
# Descargas simultáneas.
MAX_CONCURRENT=2

# Pon false solo si pruebas por http://IP:8000 sin HTTPS.
SECURE_COOKIES=true

# UID/GID del dueño de ./data (por defecto el primer usuario de Linux).
CLIPO_UID=1000
CLIPO_GID=1000
